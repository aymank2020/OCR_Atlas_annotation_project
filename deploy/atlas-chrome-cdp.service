[Unit]
Description=Persistent Chrome for Gemini Chat Web (CDP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atlas
Environment=DISPLAY=:99
Environment=CHROME_BIN=/usr/bin/google-chrome-stable
# Memory limit to prevent Chrome from eating all RAM
MemoryMax=4G

# Start Xvfb before Chrome
ExecStartPre=/bin/bash -c 'if ! pgrep -x Xvfb > /dev/null; then /usr/bin/Xvfb :99 -screen 0 1920x1080x24 -ac +extension RANDR +extension GLX & sleep 2; fi'

ExecStart=/usr/bin/google-chrome-stable \
  --remote-debugging-port=9222 \
  --remote-debugging-address=127.0.0.1 \
  --user-data-dir=/srv/atlas/OCR_annotation_Atlas/.state/gemini_chat_user_data \
  --no-sandbox \
  --disable-dev-shm-usage \
  --disable-gpu \
  --disable-software-rasterizer \
  --disable-blink-features=AutomationControlled \
  --no-first-run \
  --no-default-browser-check \
  --disable-extensions \
  --disable-plugins \
  --disable-background-networking \
  --disable-sync \
  --disable-translate \
  --metrics-recording-only \
  --disable-default-apps \
  --disable-popup-blocking \
  --disable-hang-monitor \
  --disable-client-side-phishing-detection \
  --disable-component-update \
  --disable-domain-reliability \
  --disable-features=TranslateUI \
  --enable-features=NetworkService,NetworkServiceInProcess \
  --window-size=1920,1080 \
  https://gemini.google.com/app

# Restart on crash but not on normal exit
Restart=on-failure
RestartSec=10

# Give Chrome time to shutdown gracefully
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atlas-chrome-cdp

[Install]
WantedBy=multi-user.target