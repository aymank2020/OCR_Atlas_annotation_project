
# ═══════════════════════════════════════════════════════════════════════
# sample_web_auto_solver_production.yaml
# Production-grade config: Safety-first, single-model, strict gate ON
# ═══════════════════════════════════════════════════════════════════════

browser:
  headless: true
  slow_mo_ms: 80
  storage_state_path: ".state/atlas_auth.json"
  force_login: false
  use_chrome_profile: false
  fallback_to_isolated_context_on_profile_error: true
  profile_launch_timeout_ms: 30000
  chrome_channel: "chromium"

run:
  dry_run: false
  max_segments: 0
  max_episodes_per_run: 0
  reserve_cooldown_sec: 120
  reuse_cached_labels: true
  skip_unchanged_labels: true
  resume_from_artifacts: true
  # PRODUCTION SAFETY: never skip video steps
  resume_skip_video_steps_when_cached: false
  resume_skip_apply_steps_when_done: true
  auto_continuity_merge_enabled: true
  # Note: segment_chunking_enabled is set in the FULL-VIDEO-FIRST section below
  segment_chunking_temporal_anchor_enabled: true
  rag_few_shot_enabled: true
  rag_few_shot_top_k: 3
  rag_few_shot_min_score: 0.15
  object_identity_guard_enabled: true
  object_identity_guard_min_mentions: 2
  object_identity_guard_min_ratio: 0.6
  episode_end_guard_enabled: true
  max_episode_end_drift_sec: 2.0
  # PRODUCTION: always require video
  execute_require_video_context: true
  use_task_scoped_artifacts: true
  enable_quality_review_submit: true
  adjust_timestamps: true
  play_full_video_before_labeling: true
  play_full_video_max_wait_sec: 900

  # PRODUCTION SAFETY GATES (all enabled)
  pre_submit_live_recheck_enabled: true
  pre_submit_live_recheck_block_on_timestamp_errors: true
  pre_submit_live_recheck_block_on_any_policy_error: true    # stricter than default
  pre_submit_live_recheck_block_on_large_drift: true
  pre_submit_live_recheck_require_count_match: false

  # Extra Gemini compare gate before Submit
  pre_submit_gemini_compare_enabled: true
  pre_submit_gemini_compare_model: "gemini-2.5-flash"
  pre_submit_gemini_compare_attach_video: true
  pre_submit_gemini_compare_block_on_reject: true
  pre_submit_gemini_compare_fail_open: false                 # STRICT: block on error
  pre_submit_gemini_compare_log_success: true
  pre_submit_gemini_compare_save_output: true
  pre_submit_gemini_compare_dump: "pre_submit_gemini_compare.json"

  # Gemini Chat gate: disable in headless production (no browser UI)
  pre_submit_gemini_chat_compare_enabled: false

  # FULL-VIDEO-FIRST: try full video inline, fall back to chunking if fails
  segment_chunking_enabled: false
  segment_chunking_fallback_on_full_fail: true

  output_dir: "outputs"
  segments_dump: "atlas_segments_dump.json"
  labels_dump: "atlas_labels_from_gemini.json"
  prompt_dump: "atlas_prompt.txt"
  video_dump: "atlas_task_video.mp4"

atlas:
  login_url: "https://audit.atlascapture.io/login?redirect=%2F"
  dashboard_url: "https://audit.atlascapture.io/dashboard"
  room_url: "https://audit.atlascapture.io/tasks/room/normal"
  email: ""
  auth_timeout_sec: 180
  wait_before_continue_sec: 5
  timestamp_step_sec: 0.1
  timestamp_max_clicks_per_segment: 30
  selectors:
    email_input: '#email || input#email || input[type="email"]'
    start_button: 'button:has-text("Start Earning Today") || button[type="submit"]'
    otp_input: '#code || input#code || input[inputmode="numeric"]'
    verify_button: 'button:has-text("Verify") || button[type="submit"]'
    tasks_nav: 'a[href*="/tasks"] || a:has-text("Tasks")'
    enter_workflow_button: 'button:has-text("Enter Standard Workflow")'
    continue_room_button: 'button:has-text("Continue to Room")'
    label_button: 'button:has-text("Label")'
    label_task_link: 'a[href*="/tasks/room/normal/label/"]'
    reserve_episodes_button: 'button:has-text("Reserve 5 Episodes") || button:has-text("Reserve")'
    confirm_reserve_button: 'button:has-text("I Understand") || button:has-text("OK")'
    video_element: 'video'
    video_source: 'video source'
    loop_toggle_button: 'button:has-text("Loop OFF") || button:has-text("Loop ON")'
    complete_button: 'button:has-text("Complete")'
    quality_review_modal: 'div[role="dialog"]:has-text("Quality Review")'
    quality_review_checkbox: 'input[type="checkbox"]'
    quality_review_submit_button: 'button:has-text("Submit")'
    segment_rows: 'div.space-y-1.p-2 > div.rounded-lg.border.p-3'
    segment_label: 'p[title*="Double-click to edit"]'
    segment_start: 'span.font-mono.text-xs'
    segment_end: 'span.font-mono.text-xs.px-1\.5.py-0\.5'
    segment_time_plus_button: 'button:has(svg.lucide-plus)'
    segment_time_minus_button: 'button:has(svg.lucide-minus)'
    edit_button_in_row: 'button[title*="Edit"]'
    label_input: 'textarea || [contenteditable="true"]'
    save_button: 'button:has-text("Save")'

otp:
  provider: "gmail_imap"
  gmail_email: ""
  gmail_app_password: ""
  mailbox: "[Gmail]/All Mail"
  imap_host: "imap.gmail.com"
  imap_port: 993
  code_regex: "\\b(\\d{6})\\b"
  timeout_sec: 120
  poll_interval_sec: 4
  max_messages: 25
  unseen_only: false
  lookback_sec: 300

gemini:
  # ── SINGLE-MODEL MODE ───────────────────────────────────────────────
  # All stages use the same model to minimize cost and complexity.
  # Change only this one value to switch models across the entire pipeline.
  auth_mode: "vertex_ai"
  api_key: ""

  # Vertex settings
  vertex_project: ""
  vertex_location: "global"
  vertex_credentials_path: "secrets/vertex-sa.json"
  vertex_cached_content_name: ""
  vertex_cached_content_strip_system_instruction: true
  use_vertex_cached_context_only: false

  # DUAL-MODEL: flash (fast/cheap) for primary, pro for policy-retry fallback
  model: "gemini-3.1-pro-preview"
  compare_model: "gemini-3.1-pro-preview"
  chat_timed_model: "gemini-3.1-pro-preview"
  vertex_chat_model: "gemini-3.1-pro-preview"

  # Auth modes per stage
  compare_auth_mode: "vertex_ai"
  timed_labels_auth_mode: "vertex_ai"
  vertex_chat_auth_mode: "vertex_ai"
  api_update_auth_mode: "vertex_ai"

  # Fallback only when model unavailable (not for quality failures)
  compare_fallback_model: "gemini-2.5-pro"
  chat_timed_fallback_model: "gemini-2.5-pro"

  # Quality settings
  temperature: 0.0
  compare_temperature: 0.0
  timed_labels_temperature: 0.1
  compare_include_thought_process: true
  compare_response_schema_enabled: true
  timed_labels_response_schema_enabled: true
  vertex_chat_response_schema_enabled: true
  api_update_response_schema_enabled: true

  # Tier2 repair mode (recommended)
  timed_labels_repair_from_tier2: true
  timed_labels_require_gapless_timeline: true
  timed_labels_strict_action_policy: true
  timed_labels_tier2_max_chars: 16000

  # PRODUCTION: never fail open
  compare_fail_on_none: true

  # Repair loop settings (used by atlas_repair_loop.py)
  repair_max_attempts: 3
  repair_model: "gemini-2.5-pro"
  repair_auth_mode: "vertex_ai"
  repair_temperature: 0.0
  repair_timeout_sec: 120

  # Context
  context_file: "prompts/atlas_vertex_context_pack.txt"
  context_text: ""

  # Retry settings
  max_retries: 3
  retry_base_delay_sec: 2.0
  connect_timeout_sec: 30
  request_timeout_sec: 420

  # Video settings
  attach_video: true
  require_video: true
  allow_text_only_fallback_on_network_error: false
  max_inline_video_mb: 20.0
  video_download_timeout_sec: 180
  min_video_bytes: 500000
  optimize_video_target_fps: 8.0
  optimize_video_min_fps: 4.0
  optimize_video_target_mb: 14.0
  optimize_video_only_if_larger_mb: 15.0

  # GCS video transport (Vertex AI) - full video without inline limits
  # Setup: gsutil mb gs://atlas-solver-videos
  # Grant: gsutil iam ch serviceAccount:<SA>:objectCreator gs://atlas-solver-videos
  gcs_video_bucket: ""  # Set bucket name to enable GCS transport

  # PRODUCTION: retry with pro model on policy fail (flash → pro)
  retry_with_stronger_model_on_policy_fail: true
  policy_retry_model: "gemini-2.5-pro"
  policy_retry_only_if_flash: true
  policy_retry_accept_equal_error_count: false

  extra_instructions: |
    Keep labels concise and imperative.
    Use "No Action" only when there is clearly no hand/object interaction.
    Never use numerals — write "two" not "2".
    Never use intent language (prepare to / try to / about to).
